---
import { livePosts } from "../lib/posts";
import Base from "../layouts/Base.astro";
import Title from "../components/Title.astro";
import ContactForm from "../components/ContactForm.astro";
import PostCard from "../components/PostCard.astro";
import hero from "../data/hero-lines.json";
import { chapters, lessons, services, outside, dreams, gratitude, contact } from "../data/story";

const posts = (await livePosts()).slice(0, 3);
const age = new Date().getFullYear() - 2006 - (new Date() < new Date(new Date().getFullYear(), 7, 14) ? 1 : 0);
const pad = (n: number) => String(n).padStart(2, "0");
const places = ["Kitwe", "Nyerere Primary", "Katoke Seminary", "Kaisho Secondary", "MUST", "Mbeya", "Software Engineer", "Digital Innovator"];
---
<Base jsonLd={{ "@context": "https://schema.org", "@type": "ProfilePage", url: "https://depriver.tech/story/", name: "My story · Privatus Cosmas", mainEntity: { "@id": "https://depriver.tech/#person" } }} title="My story · Privatus Cosmas" image="/og/story.jpg" imageAlt="From Kitwe Village to Writing Code: the story of Privatus Cosmas" description="From Kitwe village in Kagera to writing software in Mbeya: the story, the setbacks and the dreams of Privatus Cosmas.">
  <!-- ── HERO ─────────────────────────────────────────── -->
  <section class="hero" data-hero>
    <svg class="contours" viewBox={`0 0 ${hero.w} ${hero.h}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      {hero.paths.map((p) => <path d={p.d} class:list={{ major: p.major }} />)}
    </svg>
    <div class="hero-block" aria-hidden="true"></div>
    <div class="wrap hero-in">
      <div class="hero-copy">
        <p class="kicker" data-reveal>Hi, I'm Privatus. This is my story.</p>
        <h1 class="display hero-title">
          <span class="line-mask"><span>From Kitwe</span></span>
          <span class="line-mask accent"><span>Village to</span></span>
          <span class="line-mask"><span>Writing Code</span></span>
        </h1>
        <p class="lead" data-reveal>
          The setbacks, the second chances and everything in between that made me a{" "}
          <strong>Software Engineer & Digital Innovator</strong>.
        </p>
        <div class="hero-actions" data-reveal>
          <a class="btn" href="#story">Read my story
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
          </a>
          <a class="btn ghost" href="/">Visit the blog</a>
        </div>
      </div>
      <figure class="hero-photo">
        <img src="/img/me-cut.webp" alt="Portrait of Privatus Cosmas" width="900" height="1200" fetchpriority="high" />
      </figure>
      <p class="hero-name script" aria-hidden="true">Privatus <span>Cosmas</span></p>
    </div>
  </section>

  <!-- ── MARQUEE ──────────────────────────────────────── -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => places.map((p) => <span>{p}<i></i></span>))}
    </div>
  </div>

  <!-- ── PROLOGUE ─────────────────────────────────────── -->
  <section class="prologue wrap">
    <span class="label" data-reveal>Prologue</span>
    <p class="big" data-reveal>
      I'm a village boy from Kagera who once couldn't follow a lesson in English.
      I've been sent back to the bottom of the class, robbed of everything I owned and
      pushed to the edge of dropping out. <em>Every time, I started again.</em>
    </p>
    <div class="stats">
      <div data-reveal><strong><span data-count={age}>{age}</span></strong><span>Years of story</span></div>
      <div data-reveal><strong><span data-count="2">2</span>×</strong><span>Division I results</span></div>
      <div data-reveal><strong><span data-count={chapters.length}>{chapters.length}</span></strong><span>Chapters below</span></div>
    </div>
  </section>

  <!-- ── STORY ────────────────────────────────────────── -->
  <section id="story" class="story wrap">
    <aside class="rail" aria-hidden="true">
      <div class="rail-in">
        <span class="label">The story</span>
        <p class="rail-year" data-rail-year>{chapters[0].year}</p>
        <div class="rail-track"><span data-rail-line></span></div>
      </div>
    </aside>

    <div class="chapters">
      {chapters.map((c, i) => (
        <article class:list={["chapter", { dark: c.tone === "dark" }]} data-chapter={c.year} id={c.id}>
          {c.tone === "dark" && <div class="dark-bg deep" aria-hidden="true"></div>}
          <div class="ch-head">
            <span class="ch-num" data-drift>{pad(i + 1)}</span>
            <p class="ch-meta" data-reveal>
              <span class="ch-year-inline">{c.year}</span>
              <span>{c.when}</span>
              <span class="pin">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
                {c.place}
              </span>
            </p>
            <Title title={c.title} accent={c.accent} light={c.tone === "dark"} />
          </div>

          <div class:list={["ch-body", { split: c.feature === "rank" || c.feature === "robbed" }]}>
            <div class="ch-text">
              {c.body.map((p) => <p data-reveal>{p}</p>)}
            </div>

            {c.feature === "rank" && (
              <div class="rank card" data-rank data-reveal>
                <p class="card-label">Class position, 2021</p>
                <div class="rank-meter">
                  <div class="rank-bar"><span class="rank-fill"></span><span class="rank-dot"></span></div>
                  <div class="rank-labels">
                    <div><strong>2nd</strong><span>in class · <b data-count="78">78</b>% average</span></div>
                    <div><strong>2nd from last</strong><span>first-semester break</span></div>
                  </div>
                </div>
              </div>
            )}

            {c.feature === "robbed" && (
              <div class="lost card" data-reveal>
                <p class="card-label">Gone in one night</p>
                <ul>
                  {["Laptop", "Phone", "Sony FX3 camera", "All my certificates"].map((x) => <li><s>{x}</s></li>)}
                </ul>
                <p class="kept"><span>What I kept</span>My skills, and a family standing behind me.</p>
              </div>
            )}
          </div>

          {c.feature === "results" && (
            <div class="results">
              <div class="result card" data-reveal><span>Form Two</span><strong>Division I</strong><em>11 points</em></div>
              <div class="result card hot" data-reveal><span>Form Four · NECTA</span><strong>Division I</strong><em>7 points</em></div>
            </div>
          )}

          {c.quote && <p class="quote script" data-reveal>“{c.quote}”</p>}

          {c.feature === "memory" && (
            <div class="memory" data-reveal>
              <svg class="candle" viewBox="0 0 60 90" aria-hidden="true" data-draw>
                <path d="M30 8c6 9 8 14 8 19a8 8 0 0 1-16 0c0-5 2-10 8-19Z" fill="none" stroke="#e8603a" stroke-width="2.5" />
                <path d="M18 44h24v40H18z" fill="none" stroke="#a9c4f5" stroke-width="2.5" />
              </svg>
              <div>
                <p class="memory-label">In loving memory of Dad</p>
                <p class="script memory-name">Patrick</p>
              </div>
            </div>
          )}

          {c.facts && (
            <dl class="facts">
              {c.facts.map((f) => <div data-reveal><dt>{f.value}</dt><dd>{f.label}</dd></div>)}
            </dl>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- ── LESSONS ──────────────────────────────────────── -->
  <section class="lessons wrap">
    <span class="label" data-reveal>What it taught me</span>
    <Title title="Three lessons" accent="I carry everywhere" />
    <div class="lesson-grid">
      {lessons.map((l) => (
        <div class="lesson card" data-reveal>
          <span class="lesson-n">{l.n}</span>
          <h3>{l.title}</h3>
          <p>{l.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ── TODAY ────────────────────────────────────────── -->
  <section id="today" class="today deep">
    <div class="wrap">
      <span class="label" data-reveal>Chapter {pad(chapters.length + 1)} · Today</span>
      <Title title="Software Engineer" accent="& Digital Innovator" light size="clamp(2.2rem, 6vw, 4.8rem)" />
      <p class="today-lead" data-reveal>
        Today I build software full time in Mbeya: web and mobile apps, business systems and data tools,
        with real exposure to every part of tech.
      </p>
      <div class="svc-grid">
        {services.map((s, i) => (
          <div class="svc" data-reveal>
            <span>{pad(i + 1)}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
      <div class="outside" data-reveal>
        <p>Life beyond code</p>
        <ul>{outside.map((o) => <li>{o}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- ── NEXT CHAPTER ─────────────────────────────────── -->
  <section id="next" class="next wrap">
    <span class="label" data-reveal>Chapter {pad(chapters.length + 2)} · What's next</span>
    <Title title="The next" accent="chapter" size="clamp(2.4rem, 6vw, 4.6rem)" />
    <p class="next-lead" data-reveal>
      Where I'm going from here. These are the goals I wake up for.
    </p>
    <div class="dream-grid">
      {dreams.map((d, i) => (
        <div class:list={["dream", { hot: i === 1, deep: i === 1 }]} data-reveal>
          <span class="dream-icon" aria-hidden="true">
            {d.icon === "heart" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"/></svg>}
            {d.icon === "rocket" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 15c-1.5 1.3-2 4-2 6 2 0 4.7-.5 6-2m-4-4 4 4m-4-4c1-4 4.5-9.5 12-12 0 7.5-5.5 11-9.5 12.5L5 15Zm10-6h.01"/></svg>}
            {d.icon === "road" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 21 9 3m9 18L15 3M12 5v2m0 4v2m0 4v2"/></svg>}
          </span>
          <h3>{d.group}</h3>
          <ul>{d.items.map((t) => <li>{t}</li>)}</ul>
        </div>
      ))}
    </div>
    <p class="tbc script" data-reveal>To be continued…</p>
  </section>

  <!-- ── THANKS ───────────────────────────────────────── -->
  <section id="gratitude" class="thanks wrap">
    <span class="label" data-reveal>Gratitude</span>
    <Title title="The people" accent="who carried me" size="clamp(2.4rem, 6vw, 4.6rem)" />
    <p class="thanks-lead" data-reveal>
      No story like this is written alone. Some people held my hand directly. Others helped from a distance,
      sometimes without knowing it. Every one of them is part of this.
    </p>

    <h3 class="thanks-sub" data-reveal>Closest to my heart</h3>
    <div class="people">
      {gratitude.people.map((p) => {
        const initials = p.name.split(/\s*&\s*|\s+/).map((w) => w[0]).slice(0, 2).join("");
        return (
          <article class="person-wrap" data-reveal>
          <div class:list={["person", { "in-memory": p.memory }]} data-tilt>
            <div class="frame">
              {p.photo
                ? <img src={p.photo} alt={`${p.relation}: ${p.name}`} loading="lazy" />
                : <div class="mono deep" aria-hidden="true"><span class="ring"></span><span class="script">{initials}</span></div>}
              {p.memory && <span class="badge">In loving memory</span>}
              <div class="reveal" aria-hidden="true"><span class="script">Asante, {p.name.split(" ")[0]}</span></div>
            </div>
            <div class="info">
              <p class="rel">{p.relation}</p>
              <h4 class="p-name">{p.name}</h4>
              <p class="p-note">{p.note}</p>
            </div>
          </div>
          </article>
        );
      })}
    </div>

    <h3 class="thanks-sub" data-reveal>And everyone along the way</h3>
    <div class="groups">
      {gratitude.groups.map((g, i) => (
        <div class="group" data-reveal>
          <span class="g-n">{String(i + 1).padStart(2, "0")}</span>
          <p class="g-title">{g.title}</p>
          <p class="g-note">{g.note}</p>
        </div>
      ))}
    </div>

    <div class="asante deep" data-reveal>
      <p class="script">Asante sana</p>
      <div>
        <p>To everyone who helped me, directly or indirectly, named here or not: thank you. This story is yours too.</p>
        <p class="you">And to you, reading this right now: thank you for walking through my story. If it helped you, pass it on to someone who needs it.</p>
      </div>
    </div>
  </section>

  <!-- ── BLOG ─────────────────────────────────────────── -->
  <section class="latest wrap">
    <div class="latest-head">
      <div>
        <span class="label" data-reveal>From the blog</span>
        <Title title="The story" accent="continues here" size="clamp(2rem, 5vw, 3.6rem)" />
      </div>
      <a class="btn ghost" href="/" data-reveal>All posts</a>
    </div>
    <div class="post-grid">
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  </section>

  <!-- ── CONTACT ──────────────────────────────────────── -->
  <section id="contact" class="contact wrap">
    <div class="contact-card deep" data-reveal>
      <div>
        <span class="label">Let's connect</span>
        <h2 class="display light">Let's build <span class="accent">something together</span></h2>
        <p>Have a project, an idea or just want to say hi? My inbox is always open.</p>
        <a class="btn" href={contact.whatsappHref} target="_blank" rel="noopener">Chat on WhatsApp
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <ContactForm />
      </div>
      <dl>
        <div><dt>Phone</dt><dd><a href={contact.phoneHref}>{contact.phone}</a></dd></div>
        <div><dt>Instagram</dt><dd><a href={contact.instagramHref} target="_blank" rel="noopener">{contact.instagram}</a></dd></div>
        <div><dt>GitHub</dt><dd><a href={contact.githubHref} target="_blank" rel="noopener">{contact.github}</a></dd></div>
        <div><dt>Website</dt><dd>depriver.tech</dd></div>
      </dl>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { position: relative; min-height: 100svh; padding: 0; overflow: hidden; }
  .contours { position: absolute; right: 0; top: 0; width: 58%; height: 100%; fill: none; stroke: var(--accent-2); stroke-width: 1.3; opacity: 0.55; pointer-events: none; -webkit-mask-image: linear-gradient(90deg, transparent, #000 30%); mask-image: linear-gradient(90deg, transparent, #000 30%); }
  .contours .major { stroke: var(--accent); stroke-width: 1.6; opacity: 0.8; }
  .hero-block { position: absolute; left: 0; bottom: 0; width: 46%; height: 24svh; background: var(--deep); border-top: 18px solid var(--accent-2); }
  .hero-in { position: relative; display: grid; grid-template-columns: 1.3fr 0.9fr; min-height: 100svh; }
  .hero-copy { padding: 120px 0 calc(24svh + 40px); position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: center; }
  .kicker { font-weight: 500; font-size: 1.1rem; color: var(--heading); margin: 0 0 14px; }
  .hero-title { font-size: clamp(2.8rem, 6vw, 5.6rem); }
  .lead { max-width: 30rem; color: var(--muted); font-size: 1.08rem; margin: 22px 0 26px; }
  .lead strong { color: var(--heading); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-photo { margin: 0; position: absolute; right: 0; bottom: 0; width: min(46vw, 720px); height: 92svh; overflow: hidden; z-index: 1; }
  .hero-photo img { width: 100%; height: 100%; object-fit: contain; object-position: bottom center; }
  .hero-name { position: absolute; left: 0; bottom: 3svh; margin: 0; color: var(--on-deep); font-size: clamp(3rem, 5.6vw, 5.4rem); line-height: 0.95; z-index: 3; }
  .hero-name span { display: block; padding-left: 0.7em; background: linear-gradient(transparent 55%, var(--accent) 55%, var(--accent) 85%, transparent 85%) no-repeat 0.75em 0 / 2.1em 100%; }

  /* MARQUEE */
  .marquee { background: var(--accent); color: var(--on-accent); overflow: hidden; padding: 18px 0; transform: rotate(-1.2deg) scale(1.02); margin: 10px 0 40px; }
  .marquee-track { display: flex; width: max-content; animation: marquee 38s linear infinite; }
  .marquee span { display: flex; align-items: center; gap: 28px; padding-right: 28px; font-weight: 600; font-size: 1.25rem; white-space: nowrap; }
  .marquee i { width: 10px; height: 10px; border-radius: 50%; background: var(--deep); }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee-track { animation: none; } }

  /* PROLOGUE */
  .prologue { padding: 100px 0 60px; }
  .big { font-size: clamp(1.5rem, 3.3vw, 2.5rem); line-height: 1.35; font-weight: 500; color: var(--heading); max-width: 22em; margin: 28px 0 56px; letter-spacing: -0.01em; }
  .big em { font-style: normal; color: var(--accent); }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .stats div { background: var(--deep); color: var(--deep-text); border-radius: var(--radius); padding: 30px 32px; }
  .stats strong { display: block; font-size: clamp(2.6rem, 6vw, 4.2rem); color: var(--on-deep); line-height: 1; margin-bottom: 8px; }
  .stats div:nth-child(2) { background: var(--accent); color: var(--on-accent); }

  /* STORY */
  .story { display: grid; grid-template-columns: 240px 1fr; gap: 56px; padding: 80px 0; }
  .rail-in { position: sticky; top: 120px; display: flex; flex-direction: column; gap: 20px; }
  .rail-year { font-size: 5.4rem; font-weight: 700; color: var(--accent); line-height: 1; margin: 0; letter-spacing: -0.04em; }
  .rail-track { width: 4px; height: 46vh; background: var(--line); border-radius: 2px; overflow: hidden; }
  .rail-track span { display: block; width: 100%; height: 100%; background: var(--deep); transform-origin: top; transform: scaleY(0); }

  .chapter { position: relative; padding: 70px 0 90px; border-bottom: 1px solid var(--line); }
  .chapter:last-child { border-bottom: 0; }
  .ch-head { position: relative; }
  .ch-num { position: absolute; right: 0; top: -40px; font-size: clamp(6rem, 14vw, 12rem); font-weight: 700; line-height: 1; color: transparent; -webkit-text-stroke: 2px var(--line); pointer-events: none; z-index: -1; }
  .ch-meta { display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center; margin: 0 0 18px; font-weight: 500; color: var(--muted); font-size: 0.95rem; }
  .ch-year-inline { display: none; font-weight: 700; color: var(--accent); }
  .pin { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px; background: var(--surface-2); color: var(--heading); }
  .ch-body { margin-top: 30px; }
  .ch-body.split { display: grid; grid-template-columns: 1.3fr 0.9fr; gap: 40px; align-items: start; }
  .ch-text p { font-size: 1.12rem; color: var(--text); margin: 0 0 18px; max-width: 40em; }

  .card { background: var(--surface); border-radius: var(--radius); padding: 28px; box-shadow: 0 1px 0 var(--line), 0 30px 60px -40px color-mix(in srgb, var(--shadow) 35%, transparent); }
  .card-label { margin: 0 0 20px; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }

  .rank { background: var(--deep); color: var(--deep-text); position: sticky; top: 120px; }
  .rank-meter { display: grid; grid-template-columns: 26px 1fr; gap: 22px; height: 300px; }
  .rank-bar { position: relative; background: color-mix(in srgb, var(--accent-2) 18%, transparent); border-radius: 13px; }
  .rank-fill { position: absolute; inset: 0; border-radius: 13px; background: linear-gradient(to top, var(--accent-2), var(--accent)); transform-origin: bottom; }
  .rank-dot { position: absolute; left: 50%; top: 4%; width: 34px; height: 34px; margin-left: -17px; border-radius: 50%; background: var(--surface); border: 7px solid var(--accent); box-shadow: 0 0 0 8px color-mix(in srgb, var(--accent) 25%, transparent); }
  .rank-labels { display: flex; flex-direction: column; justify-content: space-between; }
  .rank-labels strong { display: block; color: var(--on-deep); font-size: 1.7rem; line-height: 1.1; }
  .rank-labels div:first-child strong { color: var(--accent); font-size: 2.4rem; }
  .rank-labels b { color: var(--on-deep); }

  .lost ul { list-style: none; padding: 0; margin: 0 0 22px; display: grid; gap: 12px; }
  .lost li { font-size: 1.2rem; font-weight: 600; color: var(--heading); }
  .lost s { text-decoration-color: var(--accent); text-decoration-thickness: 3px; }
  .kept { margin: 0; padding: 18px 20px; border-radius: 18px; background: var(--surface-2); color: var(--heading); font-weight: 500; }
  .kept span { display: block; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }

  .results { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 30px; }
  .result { display: flex; flex-direction: column; gap: 4px; }
  .result span { font-size: 0.85rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .result strong { font-size: clamp(2rem, 4.5vw, 3.2rem); color: var(--heading); line-height: 1.1; }
  .result em { font-style: normal; font-weight: 600; color: var(--accent); font-size: 1.2rem; }
  .result.hot { background: var(--accent); }
  .result.hot span, .result.hot em { color: color-mix(in srgb, var(--on-accent) 85%, transparent); }
  .result.hot strong { color: var(--on-accent); }
  .quote { font-size: clamp(2.4rem, 5vw, 3.8rem); color: var(--heading); margin: 40px 0 0; line-height: 1.1; }

  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 34px 0 0; }
  .facts div { border-top: 4px solid var(--accent); padding-top: 14px; }
  .facts dt { font-size: clamp(1.5rem, 3vw, 2.1rem); font-weight: 700; color: var(--heading); line-height: 1.1; }
  .facts dd { margin: 4px 0 0; color: var(--muted); font-size: 0.92rem; }

  /* the hardest season */
