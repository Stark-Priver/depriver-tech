---
import Base from "../../layouts/Base.astro";
import Title from "../../components/Title.astro";
import { guides, guideFile, guideAsset } from "../../data/guides";
import { livePosts } from "../../lib/posts";
const live = new Set((await livePosts()).map((p) => p.id));
const sorted = [...guides].sort((a, b) => b.date.localeCompare(a.date));
const fmt = (d: string) => new Date(d + "T12:00:00+03:00").toLocaleDateString("en-GB", { month: "long", year: "numeric" });
---
<Base title="Guides · Privatus Cosmas" description="Free books and guides for students and beginners in tech: read online or download the PDF.">
  <section class="head wrap">
    <span class="label" data-reveal>Guides</span>
    <Title tag="h1" title="Free books" accent="& guides." size="clamp(2.6rem, 6vw, 4.8rem)" />
    <p class="intro" data-reveal>Longer, deeper and free. Everything a carousel can't fit, written as a proper book you can read online, print or share.</p>
  </section>

  <section class="wrap list">
    {sorted.map((g, i) => (
      <article class="guide" data-reveal>
        <a class="book" href={guideFile(g.slug)} target="_blank" rel="noopener" aria-label={`Open ${g.title} (PDF)`}>
          <img src={guideAsset(g.slug, "cover.webp")} alt={`Cover of ${g.title}`} width="720" height="1018" loading={i ? "lazy" : "eager"} />
        </a>
        <div class="info">
          <p class="when">Free book · {fmt(g.date)}</p>
          <h2>{g.title}</h2>
          <p class="sub">{g.subtitle}</p>
          <p class="desc">{g.description}</p>
          <ul class="facts">
            <li><b>{g.pages}</b> pages</li>
            <li><b>PDF</b> {g.sizeMB} MB</li>
            <li><b>Level</b> {g.level}</li>
          </ul>
          <div class="actions">
            <a class="btn" href={guideFile(g.slug)} download>Download free
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"/></svg>
            </a>
            <a class="btn ghost" href={guideFile(g.slug)} target="_blank" rel="noopener">Read online</a>
            {g.post && live.has(g.post) && <a class="more" href={`/blog/${g.post}/`}>The roadmap post <span aria-hidden="true">→</span></a>}
          </div>
          <details class="toc">
            <summary>What's inside: {g.chapters.length} chapters</summary>
            <ol>{g.chapters.map((c) => <li>{c}</li>)}</ol>
          </details>
        </div>
        <div class="peek" aria-label="Preview pages">
          {g.previews.map((p) => (
            <img src={guideAsset(g.slug, `page-${p}.webp`)} alt={`Page ${Number(p)} of ${g.title}`} width="480" height="679" loading="lazy" />
          ))}
        </div>
      </article>
    ))}
  </section>

  <section class="wrap invite" data-reveal>
    <div class="deep invite-in">
      <p class="label">Ask for a guide</p>
      <h2>What should the next book be about?</h2>
      <p>A language, a career path, your final-year project or your first job. Tell me what you're stuck on and it might become the next free guide.</p>
      <div class="invite-actions">
        <a class="btn" href="https://wa.me/255752747681" target="_blank" rel="noopener">Suggest on WhatsApp
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a class="link" href="/talks/">Or see my talks <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .head { padding: 150px 0 50px; }
  .head :global(.display) { margin-top: 20px; }
  .intro { font-size: 1.15rem; color: var(--muted); max-width: 34em; margin: 22px 0 0; }
  .list { display: grid; gap: 28px; padding-bottom: 60px; }
  .guide { display: grid; grid-template-columns: minmax(220px, 0.8fr) 1.4fr; gap: 28px 44px; align-items: start; padding: clamp(20px, 4vw, 40px);
    border-radius: var(--radius); background: var(--surface); box-shadow: 0 1px 0 var(--line), 0 30px 60px -40px color-mix(in srgb, var(--shadow) 35%, transparent); }
  .book { display: block; perspective: 1200px; }
  .book img { width: 100%; height: auto; border-radius: 4px 10px 10px 4px; transform: rotateY(-8deg) rotateZ(-1deg); transform-origin: left center;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--heading) 16%, transparent), -6px 0 0 -2px color-mix(in srgb, var(--deep) 60%, transparent), 22px 30px 50px -18px color-mix(in srgb, var(--shadow) 70%, transparent);
    transition: transform 0.7s var(--ease); }
  .book:hover img { transform: rotateY(0) rotateZ(0) translateY(-6px); }
  .info { display: grid; gap: 12px; align-content: start; min-width: 0; }
  .when { margin: 0; color: var(--accent); font-weight: 600; font-size: 0.9rem; }
  h2 { margin: 0; font-size: clamp(2rem, 4.4vw, 3.2rem); line-height: 1.05; letter-spacing: -0.03em; color: var(--heading); }
  .sub { margin: 0; font-weight: 600; font-size: 1.15rem; color: var(--heading); }
  .desc { margin: 0; color: var(--muted); max-width: 38em; }
  .facts { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 6px 0 0; }
  .facts li { padding: 7px 14px; border-radius: 999px; font-size: 0.88rem; color: var(--muted); box-shadow: inset 0 0 0 1.5px var(--line); }
  .facts b { color: var(--heading); margin-right: 4px; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin-top: 8px; }
  .more, .link { font-weight: 600; text-decoration: none; color: var(--heading); }
  .more:hover, .link:hover { color: var(--accent); }
  .toc { margin-top: 6px; border-top: 1px solid var(--line); padding-top: 14px; }
  .toc summary { cursor: pointer; font-weight: 600; color: var(--heading); }
  .toc ol { margin: 12px 0 0; padding-left: 1.4em; columns: 2; column-gap: 28px; color: var(--muted); }
  .toc li { break-inside: avoid; padding: 3px 0; }
  .toc li::marker { color: var(--accent); font-weight: 600; }
  .peek { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .peek img { width: 100%; height: auto; border-radius: 8px; box-shadow: 0 1px 0 var(--line), 0 18px 30px -22px color-mix(in srgb, var(--shadow) 60%, transparent); }
  .invite { padding-bottom: 120px; }
  .invite-in { padding: clamp(32px, 6vw, 64px); border-radius: var(--radius); color: var(--deep-text); display: grid; gap: 14px; justify-items: start; }
  .invite h2 { color: var(--on-deep); font-size: clamp(1.6rem, 3vw, 2.3rem); max-width: 16em; }
  .invite p:not(.label) { margin: 0; max-width: 34em; }
  .invite-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; }
  .invite .link { color: var(--on-deep); }
  @media (max-width: 860px) {
    .guide { grid-template-columns: 1fr; }
    .book { max-width: 300px; }
    .peek { grid-template-columns: repeat(2, 1fr); }
    .toc ol { columns: 1; }
  }
</style>
