---
// /contact: contacts only, for the QR code on talk slides and posters. No nav, footer or assistant.
import Base from "../layouts/Base.astro";
import { contact } from "../data/story";

const wa = `${contact.whatsappHref}?text=${encodeURIComponent("Habari Privatus, nimepata namba yako kwenye depriver.tech.")}`;
const links = [
  { label: "WhatsApp", value: contact.phone, href: wa, icon: "wa", primary: true, external: true },
  { label: "Call", value: contact.phone, href: contact.phoneHref, icon: "phone" },
  { label: "Instagram", value: contact.instagram, href: contact.instagramHref, icon: "ig", external: true },
  { label: "GitHub", value: contact.github, href: contact.githubHref, icon: "gh", external: true },
  { label: "Website", value: "depriver.tech", href: "/", icon: "web" },
];
---
<Base bare title="Contact · Privatus Cosmas" description="Contact Privatus Cosmas (@_depriver): WhatsApp, phone, Instagram and GitHub."
  jsonLd={{ "@context": "https://schema.org", "@type": "ContactPage", url: "https://depriver.tech/contact/", mainEntity: { "@id": "https://depriver.tech/#person" } }}>
  <section class="contact-page">
    <div class="sheet">
      <header>
        <img class="avatar" src="/img/me-cut-540.webp" alt="Privatus Cosmas" width="112" height="112" />
        <p class="label">Let's connect · Tuwasiliane</p>
        <h1>Privatus Cosmas</h1>
        <p class="role">Software Engineer &amp; Digital Innovator · Founder, INCPRITECH</p>
      </header>

      <ul class="links">
        {links.map((l) => (
          <li>
            <a class:list={["link", { primary: l.primary }]} href={l.href} {...(l.external ? { target: "_blank", rel: "noopener" } : {})}>
              <span class="icon" aria-hidden="true">
                {l.icon === "wa" && <svg viewBox="0 0 24 24"><path d="M20.5 3.5A11 11 0 0 0 3.2 17.1L2 22l5-1.2A11 11 0 1 0 20.5 3.5Zm-8.4 17a9 9 0 0 1-4.6-1.3l-.3-.2-3 .7.8-2.9-.2-.3a9 9 0 1 1 7.3 4Zm5-6.7c-.3-.1-1.6-.8-1.9-.9s-.4-.1-.6.1-.7.9-.9 1.1-.3.2-.6.1a7.4 7.4 0 0 1-3.7-3.2c-.3-.5.3-.5.8-1.6a.5.5 0 0 0 0-.5l-.9-2c-.2-.6-.5-.5-.6-.5h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-1 2.3 5.3 5.3 0 0 0 1.1 2.8 12 12 0 0 0 4.6 4.1c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.9-1.3 2.3 2.3 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z" fill="currentColor"/></svg>}
                {l.icon === "phone" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"/></svg>}
                {l.icon === "ig" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>}
                {l.icon === "gh" && <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 2.9.8.1-.6.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5a3.9 3.9 0 0 1 1-2.7 3.6 3.6 0 0 1 .1-2.7s.9-.3 2.8 1a9.5 9.5 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1a3.6 3.6 0 0 1 .1 2.7 3.9 3.9 0 0 1 1 2.7c0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9V21c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"/></svg>}
                {l.icon === "web" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>}
              </span>
              <span class="text"><span class="name">{l.label}</span><span class="value">{l.value}</span></span>
              <svg class="go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </li>
        ))}
      </ul>

      <a class="save" href="/privatus-cosmas.vcf" download>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></svg>
        Save my contact
      </a>

      <p class="sign">Karibu sana</p>
      <p class="foot"><a href="/">depriver.tech</a> · @_depriver</p>
    </div>
  </section>
</Base>

<style>
  .contact-page { min-height: 100svh; display: grid; place-items: start center; padding: clamp(28px, 6vh, 64px) 16px 40px;
    background: radial-gradient(120% 60% at 50% 0%, var(--surface-2), var(--bg) 70%); }
  .sheet { width: 100%; max-width: 480px; }
  header { text-align: center; margin-bottom: 26px; }
  .avatar { display: block; margin: 0 auto; width: 112px; height: 112px; border-radius: 50%; object-fit: cover; object-position: top; background: var(--accent-2);
    border: 4px solid var(--surface); box-shadow: 0 0 0 3px var(--heading); filter: var(--photo-filter); }
  .label { display: flex; align-items: center; margin: 18px 0 6px; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); }
  h1 { margin: 0; font-size: clamp(1.9rem, 7vw, 2.4rem); line-height: 1.05; color: var(--heading); }
  .role { margin: 8px 0 0; color: var(--muted); font-size: 0.98rem; }
  .links { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .link { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border-radius: 18px; text-decoration: none;
    background: var(--surface); border: 2px solid var(--heading); box-shadow: 5px 6px 0 var(--neu-lo); color: var(--heading);
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease); }
  .link:hover, .link:focus-visible { transform: translate(-2px, -2px); box-shadow: 7px 8px 0 var(--neu-lo); }
  .link.primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .icon { flex: none; width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--surface-2); color: var(--heading); }
  .primary .icon { background: rgba(255, 255, 255, 0.2); color: var(--on-accent); }
  .icon svg { width: 22px; height: 22px; }
  .text { display: grid; flex: 1; min-width: 0; }
  .name { font-weight: 700; font-size: 1.02rem; }
  .value { font-size: 0.92rem; opacity: 0.8; overflow-wrap: anywhere; }
  .go { flex: none; width: 20px; height: 20px; opacity: 0.7; }
  .save { margin-top: 18px; display: flex; justify-content: center; align-items: center; gap: 10px; padding: 15px; border-radius: 18px;
    background: var(--surface); border: 2px dashed var(--accent); color: var(--heading); font-weight: 700; text-decoration: none; }
  .save svg { width: 20px; height: 20px; color: var(--accent); }
  .sign { margin: 28px 0 0; text-align: center; font-family: "Mr Dafoe", cursive; font-size: 2rem; color: var(--accent); }
  .foot { margin: 6px 0 0; text-align: center; color: var(--muted); font-size: 0.9rem; }
  .foot a { color: var(--heading); font-weight: 600; text-decoration: none; }
</style>
