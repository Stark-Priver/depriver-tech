---
// PDF version: the browser's own PDF viewer, full window, with a slim top bar. Phones get a download / open button.
import Base from "../../../layouts/Base.astro";
import { talks, talkBase } from "../../../data/talks";

export function getStaticPaths() {
  return talks.map((t) => ({ params: { slug: t.slug }, props: { talk: t } }));
}
const { talk } = Astro.props;
const base = talkBase(talk.slug);
const pdf = `${base}${talk.slug}.pdf`;
---
<Base bare title={`PDF · ${talk.title}`} description={talk.description} image={`${base}cover.jpg`} imageAlt={talk.title}>
  <div class="pdfview">
    <header>
      <a class="back" href={base}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span>{talk.title}</span>
      </a>
      <nav>
        <a href={`${base}present/`}>Present</a>
        <a class="dl" href={pdf} download>Download PDF</a>
      </nav>
    </header>
    <object data={`${pdf}#view=FitH`} type="application/pdf" aria-label={`${talk.title} (PDF)`}>
      <div class="fallback">
        <p>Your browser can't show the PDF here.</p>
        <a class="btn" href={pdf}>Open the PDF ({talk.pdfMB} MB)</a>
      </div>
    </object>
  </div>
</Base>

<style is:global>
  html:has(.pdfview), html:has(.pdfview) body { height: 100%; overflow: hidden; }
  .pdfview { position: fixed; inset: 0; display: flex; flex-direction: column; background: #0b1e3f; }
  .pdfview header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 10px 18px; color: #fff; }
  .pdfview a { color: #fff; text-decoration: none; font-weight: 600; font-size: 0.95rem; }
  .pdfview .back { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .pdfview .back span { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .pdfview .back svg { width: 20px; height: 20px; flex: none; }
  .pdfview nav { display: flex; gap: 8px; flex: none; }
  .pdfview nav a { padding: 8px 14px; border-radius: 999px; background: rgba(255, 255, 255, 0.1); }
  .pdfview nav a.dl { background: #e8603a; }
  .pdfview object { flex: 1; width: 100%; border: 0; background: #2a3550; }
  .pdfview .fallback { height: 100%; display: grid; place-content: center; text-align: center; gap: 16px; color: #fff; padding: 24px; }
</style>
