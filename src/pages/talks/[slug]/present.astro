---
// Full-screen web presenter with PowerPoint-style Morph transitions. Keys: arrows / space, F = full screen.
import Base from "../../../layouts/Base.astro";
import { talks, talkBase } from "../../../data/talks";

export function getStaticPaths() {
  return talks.map((t) => ({ params: { slug: t.slug }, props: { talk: t } }));
}
const { talk } = Astro.props;
const base = talkBase(talk.slug);
---
<Base bare noindex title={`Present · ${talk.title}`} description={talk.description} image={`${base}cover.jpg`} imageAlt={talk.title}>
  <div class="presenter" data-presenter data-base={base}>
    <div class="viewport">
      <div class="stage" aria-live="polite"></div>
    </div>
    <div class="loading" aria-hidden="true"><span></span></div>
    <div class="progress"><span data-bar></span></div>
    <nav class="controls" aria-label="Slide controls">
      <a class="ctl back" href={base} title="Back to the talk page">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </a>
      <button class="ctl" type="button" data-prev title="Previous (Left arrow)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <span class="count" data-counter>1 / {talk.slides}</span>
      <button class="ctl" type="button" data-next title="Next (Right arrow or Space)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
      <button class="ctl" type="button" data-full title="Full screen (F)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
      </button>
    </nav>
  </div>
</Base>

<script>
  import { startPresenter } from "../../../scripts/presenter";
  startPresenter(document.querySelector<HTMLElement>("[data-presenter]")!);
</script>

<style is:global>
  html:has([data-presenter]), html:has([data-presenter]) body { margin: 0; height: 100%; overflow: hidden; background: #08152c; overscroll-behavior: none; }
  .presenter { position: fixed; inset: 0; background: #08152c; color: #fff; user-select: none; -webkit-user-select: none; touch-action: pan-y; }
  .presenter:not(.awake) { cursor: none; }
  .presenter .viewport { position: absolute; inset: 0; overflow: hidden; }
  .presenter .stage { position: absolute; left: 50%; top: 50%; width: 1920px; height: 1080px; transform-origin: 50% 50%; overflow: hidden;
    background: #f4f5f8; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45); opacity: 0; transition: opacity 0.5s ease; }
  .presenter.ready .stage { opacity: 1; }
  .presenter .layer { position: absolute; inset: 0; }
  .presenter .shp { position: absolute; box-sizing: border-box; will-change: transform, opacity; }
  .presenter .shp img { display: block; width: 100%; height: 100%; }
  .presenter .tx { position: absolute; inset: 0; display: flex; flex-direction: column; font-family: "Poppins", sans-serif; overflow-wrap: break-word; }
  .presenter .tx p { margin: 0; }
  .presenter .progress { position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: rgba(255, 255, 255, 0.08); z-index: 5; }
  .presenter .progress span { display: block; height: 100%; background: #e8603a; transform-origin: 0 50%; transform: scaleX(0); transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
  .presenter .controls { position: absolute; left: 50%; bottom: 22px; transform: translate(-50%, 16px); display: flex; align-items: center; gap: 6px; padding: 8px;
    border-radius: 999px; background: rgba(11, 30, 63, 0.82); backdrop-filter: blur(10px); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35); z-index: 6;
    opacity: 0; transition: opacity 0.3s ease, transform 0.3s ease; }
  .presenter.awake .controls, .presenter .controls:focus-within { opacity: 1; transform: translate(-50%, 0); }
  .presenter .ctl { display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: transparent; color: #fff; cursor: pointer; }
  .presenter .ctl:hover, .presenter .ctl:focus-visible { background: rgba(255, 255, 255, 0.12); outline: none; }
  .presenter .ctl svg { width: 22px; height: 22px; }
  .presenter .count { min-width: 74px; text-align: center; font: 600 15px/1 "Poppins", sans-serif; font-variant-numeric: tabular-nums; color: #c4d0e8; }
  .presenter .loading { position: absolute; left: 50%; top: 50%; width: 46px; height: 46px; margin: -23px; border-radius: 50%; border: 4px solid rgba(255,255,255,0.15);
    border-top-color: #e8603a; animation: spin 0.9s linear infinite; }
  .presenter.ready .loading { display: none; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
