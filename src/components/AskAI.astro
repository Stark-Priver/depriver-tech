---
// Viora: Privatus's AI assistant. Answers stream in from Cloudflare Workers AI and are typed out smoothly.
import { site } from "../data/site";
const suggestions = ["What does Privatus do?", "Can he build an app for my business?", "Tell me his story in short", "How can I contact him?"];
---
{site.engageApi && (
  <div class="vi" data-vi data-api={site.engageApi}>
    <p class="vi-hello" data-vi-hello hidden>
      <button type="button" class="vi-hello-x" data-vi-hello-x aria-label="Dismiss">×</button>
      <span>Hi, I'm <b class="vi-brand">viora</b> 👋</span> Ask me anything about Privatus: his work, his story, or how he can help you.
    </p>

    <button class="vi-fab" type="button" data-vi-toggle aria-expanded="false" aria-controls="vi-panel" aria-label="Chat with viora, Privatus's AI assistant">
      <span class="orb" aria-hidden="true"><i></i></span>
      <span class="vi-fab-text"><b class="vi-brand">viora</b><small>ask me about privatus</small></span>
    </button>

    <section class="vi-panel" id="vi-panel" role="dialog" aria-label="viora, Privatus's AI assistant" data-lenis-prevent hidden>
      <header class="vi-head">
        <span class="orb big" aria-hidden="true"><i></i></span>
        <div class="vi-id">
          <p class="vi-name vi-brand">viora</p>
          <p class="vi-status"><i></i> Privatus's AI assistant · online</p>
        </div>
        <button class="vi-icon" type="button" data-vi-reset aria-label="New conversation" title="New conversation">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
        </button>
        <button class="vi-icon" type="button" data-vi-close aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </header>

      <div class="vi-log" data-vi-log data-lenis-prevent aria-live="polite"></div>

      <form class="vi-form" data-vi-form>
        <input name="q" type="text" maxlength="500" autocomplete="off" placeholder="Message viora… (English or Swahili)" aria-label="Your question" required />
        <button type="submit" aria-label="Send" data-vi-send>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7Z"/></svg>
        </button>
      </form>
      <footer class="vi-foot">
        <p><span class="vi-brand sm">viora</span> can make mistakes.</p>
        <a class="vi-wa" href="https://wa.me/255752747681?text=Hi%20Privatus%2C%20I%20found%20you%20on%20depriver.tech" target="_blank" rel="noopener">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.8 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.3 0 .5l-.4.6-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3Z"/></svg>
          Message Privatus
        </a>
      </footer>
    </section>

    <template data-vi-welcome>
      <div class="vi-msg bot"><span class="orb tiny" aria-hidden="true"><i></i></span><p>Hi, I'm <b class="vi-brand">viora</b> 👋 I can tell you about Privatus: his work, his story and how he can help you. What would you like to know?</p></div>
      <div class="vi-sugs" data-vi-sugs>
        {suggestions.map((s, i) => <button type="button" data-sug style={`--i:${i}`}>{s}</button>)}
      </div>
    </template>
  </div>
)}

<script>
  const root = document.querySelector<HTMLElement>("[data-vi]");
  if (root) {
    const api = root.dataset.api!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const panel = root.querySelector<HTMLElement>(".vi-panel")!;
    const fab = root.querySelector<HTMLButtonElement>("[data-vi-toggle]")!;
    const log = root.querySelector<HTMLElement>("[data-vi-log]")!;
    const form = root.querySelector<HTMLFormElement>("[data-vi-form]")!;
    const input = form.querySelector<HTMLInputElement>("input")!;
    const send = root.querySelector<HTMLButtonElement>("[data-vi-send]")!;
    const hello = root.querySelector<HTMLElement>("[data-vi-hello]")!;
    const welcome = root.querySelector<HTMLTemplateElement>("[data-vi-welcome]")!;
    let history: { role: "user" | "assistant"; content: string }[] = [];
    let busy = false;

    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
    // light Markdown: **bold**, bullet lines, links, line breaks
    const fmt = (s: string) => esc(s.trim())
      .replace(/\*\*(.+?)\*\*/g, "<b>$1</b>")
      .replace(/^\s*[*-]\s+(.*)$/gm, "• $1")
      .replace(/(https?:\/\/[^\s)<]+[^\s).,<])/g, '<a href="$1" target="_blank" rel="noopener">$1</a>')
      .replace(/(\+255[\d ]{9,12}\d)/g, (m) => `<a href="https://wa.me/${m.replace(/\D/g, "")}" target="_blank" rel="noopener">${m}</a>`)
      .replace(/\n/g, "<br />");

    // formatting while typing (bold + bullets); links are added once the answer is complete
    const live = (s: string) => esc(s)
      .replace(/\*\*(.+?)\*\*/g, "<b>$1</b>")
      .replace(/^\s*[*-]\s+/gm, "• ")
      .replace(/\n/g, "<br />");

    // Follow new text only while the reader is at the bottom; if they scroll up to reread, leave them there.
    let stick = true;
    log.addEventListener("scroll", () => { stick = log.scrollHeight - log.scrollTop - log.clientHeight < 60; }, { passive: true });
    const scroll = (force = false) => {
      if (force) stick = true;
      if (stick) log.scrollTop = log.scrollHeight;
    };

    function resetChat() {
      history = [];
      log.innerHTML = "";
      log.append(welcome.content.cloneNode(true));
    }
    resetChat();

    // ── open / close with animation ─────────────────────────
    function open() {
      hideHello(true);
      panel.hidden = false;
      panel.classList.remove("closing");
      root.classList.add("open");
      fab.setAttribute("aria-expanded", "true");
      setTimeout(() => input.focus(), reduce ? 0 : 250);
    }
    function close() {
      if (panel.hidden) return;
      fab.setAttribute("aria-expanded", "false");
      if (reduce) { panel.hidden = true; root.classList.remove("open"); return; }
      panel.classList.add("closing");
      panel.addEventListener("animationend", () => { panel.hidden = true; panel.classList.remove("closing"); root.classList.remove("open"); }, { once: true });
    }
    fab.addEventListener("click", () => (panel.hidden ? open() : close()));
    document.addEventListener("pointerdown", (e) => {
      if (!panel.hidden && !panel.classList.contains("closing") && !root.contains(e.target as Node)) close();
    });
    root.querySelector("[data-vi-close]")!.addEventListener("click", () => { close(); fab.focus(); });
    root.querySelector("[data-vi-reset]")!.addEventListener("click", () => { if (!busy) { resetChat(); input.focus(); } });
    panel.addEventListener("keydown", (e) => { if (e.key === "Escape") { close(); fab.focus(); } });

    // ── one-time greeting bubble ────────────────────────────
    function hideHello(forever = false) {
      hello.classList.remove("show");
      setTimeout(() => (hello.hidden = true), 300);
      if (forever) try { sessionStorage.setItem("vi-hello", "1"); } catch {}
    }
    root.querySelector("[data-vi-hello-x]")!.addEventListener("click", (e) => { e.stopPropagation(); hideHello(true); });
    hello.addEventListener("click", open);
    let seen = false;
    try { seen = sessionStorage.getItem("vi-hello") === "1"; } catch {}
    if (!seen) setTimeout(() => {
      if (!panel.hidden) return;
      hello.hidden = false;
      requestAnimationFrame(() => hello.classList.add("show"));
      setTimeout(() => hideHello(true), 9000);
    }, 4500);

    // ── messages ────────────────────────────────────────────
    function bubble(role: "user" | "bot", html = "") {
      const d = document.createElement("div");
      d.className = `vi-msg ${role}`;
      d.innerHTML = `${role === "bot" ? '<span class="orb tiny" aria-hidden="true"><i></i></span>' : ""}<p>${html}</p>`;
      log.append(d);
      scroll(true);
      return d.querySelector("p")!;
    }

    // Typewriter: text arrives in bursts from the stream; reveal it at a steady, natural pace.
    function typewriter(p: HTMLElement) {
      let target = "", shown = 0, done = false, raf = 0, resolve: () => void;
      const finished = new Promise<void>((r) => (resolve = r));
      p.classList.add("typing");
      const tick = () => {
        const backlog = target.length - shown;
        if (backlog > 0) {
          shown += reduce ? backlog : Math.max(1, Math.ceil(backlog / 18)); // speeds up if far behind
          p.innerHTML = live(target.slice(0, shown)) + '<span class="caret"></span>';
          scroll();
        }
        if (done && shown >= target.length) {
          p.classList.remove("typing");
          p.innerHTML = fmt(target);
          resolve();
          return;
        }
        raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
      return {
        push: (t: string) => (target += t),
        end: () => (done = true),
        text: () => target,
        finished,
        cancel: () => cancelAnimationFrame(raf),
      };
    }

    async function ask(q: string) {
      q = q.trim();
      if (!q || busy) return;
      busy = true;
      send.disabled = true;
      log.querySelector("[data-vi-sugs]")?.remove();
      bubble("user", esc(q));
      input.value = "";
      const p = bubble("bot", '<span class="dots"><i></i><i></i><i></i></span>');
      p.parentElement!.classList.add("thinking");
      let tw: ReturnType<typeof typewriter> | null = null;
      const start = () => { if (!tw) { p.parentElement!.classList.remove("thinking"); tw = typewriter(p); } return tw; };

      try {
        const r = await fetch(`${api}/ask`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ question: q, history, stream: true }),
        });
        if ((r.headers.get("Content-Type") || "").includes("text/event-stream") && r.body) {
          const reader = r.body.pipeThrough(new TextDecoderStream()).getReader();
          let buf = "";
          for (;;) {
            const { value, done } = await reader.read();
            if (done) break;
            buf += value;
            const lines = buf.split("\n");
            buf = lines.pop() || "";
            for (const line of lines) {
              if (!line.startsWith("data:")) continue;
              const data = line.slice(5).trim();
              if (!data || data === "[DONE]") continue;
              try {
                const j = JSON.parse(data);
                const piece = j.choices?.[0]?.delta?.content ?? j.response ?? "";
                if (piece) start().push(piece);
              } catch { /* partial line, ignore */ }
            }
          }
        } else {
          const out = await r.json();
          start().push(r.ok ? out.answer : out.error || "Sorry, something went wrong.");
        }
        const t = start();
        if (!t.text().trim()) t.push("Sorry, I couldn't answer that. You can reach Privatus on WhatsApp: +255 752 747 681.");
        t.end();
        await t.finished;
        history.push({ role: "user", content: q }, { role: "assistant", content: t.text() });
        history = history.slice(-8);
      } catch {
        const t = start();
        t.push("I couldn't connect just now. Please try again, or message Privatus on WhatsApp: +255 752 747 681.");
        t.end();
        await t.finished;
      } finally {
        busy = false;
        send.disabled = false;
        input.focus();
      }
    }

    form.addEventListener("submit", (e) => { e.preventDefault(); ask(input.value); });
    log.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-sug]");
      if (b) ask(b.textContent || "");
    });
  }
</script>

<style>
  .vi { position: fixed; right: 22px; bottom: 22px; z-index: 55; display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }

  /* ── living orb (Viora's avatar) ── */
  .orb { position: relative; flex: none; width: 40px; height: 40px; border-radius: 50%; overflow: hidden; isolation: isolate;
    background: conic-gradient(from 0deg, var(--accent), var(--accent-2), #7c5cff, var(--accent)); animation: orb-spin 6s linear infinite; }
  .orb::after { content: ""; position: absolute; inset: 22%; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #fff, rgba(255, 255, 255, 0.25) 45%, transparent 70%);
    filter: blur(1px); animation: orb-glow 3.2s ease-in-out infinite; }
  .orb i { position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle at 70% 75%, rgba(11, 30, 63, 0.35), transparent 60%); }
  .orb.big { width: 44px; height: 44px; box-shadow: 0 0 0 3px color-mix(in srgb, var(--on-deep) 14%, transparent); }
  .orb.tiny { width: 26px; height: 26px; margin-top: 2px; }
  @keyframes orb-spin { to { transform: rotate(360deg); } }
  @keyframes orb-glow { 50% { transform: scale(1.15) translate(4%, -4%); opacity: 0.8; } }

  /* viora's name: always lowercase, in the handwritten brand script */
  .vi-brand { font-family: "Mr Dafoe", cursive; font-weight: 400; text-transform: lowercase; letter-spacing: 0.01em; }
  .vi-hello .vi-brand, .vi-log :global(.vi-brand) { font-size: 1.45em; line-height: 0.8; color: var(--accent); }
  .vi-brand.sm { font-size: 1.35em; color: var(--heading); margin-right: 0.12em; }

  /* ── launcher ── */
  .vi-fab { position: relative; display: flex; align-items: center; gap: 12px; padding: 7px 20px 7px 7px; border: 0; border-radius: 999px; cursor: pointer; font: inherit; text-align: left;
    background: var(--deep); color: var(--on-deep);
    box-shadow: 0 18px 44px -14px color-mix(in srgb, var(--shadow) 75%, transparent), 0 0 0 1px color-mix(in srgb, var(--on-deep) 10%, transparent);
    animation: fab-in 0.9s var(--ease) 0.8s both; transition: transform 0.45s var(--ease), box-shadow 0.45s var(--ease); }
  .vi-fab::before { content: ""; position: absolute; left: 7px; top: 7px; width: 40px; height: 40px; border-radius: 50%; background: var(--accent);
    animation: pulse 2.6s ease-out 2s infinite; z-index: -1; }
  .vi-fab:hover { transform: translateY(-4px); box-shadow: 0 26px 50px -16px color-mix(in srgb, var(--shadow) 80%, transparent), 0 0 0 1px color-mix(in srgb, var(--on-deep) 14%, transparent); }
  .vi-fab-text { display: grid; line-height: 1.15; }
  .vi-fab-text b { font-size: 1.9rem; line-height: 0.9; margin-top: -2px; }
  .vi-fab-text small { font-size: 0.7rem; letter-spacing: 0.02em; }
  .vi-fab-text small { font-size: 0.72rem; color: var(--deep-text); }
  .vi.open .vi-fab { transform: scale(0.6); opacity: 0; pointer-events: none; }
  @keyframes fab-in { from { opacity: 0; transform: translateY(30px) scale(0.8); } }
  @keyframes pulse { 0% { transform: scale(1); opacity: 0.55; } 70%, 100% { transform: scale(1.9); opacity: 0; } }

  /* ── greeting bubble ── */
  .vi-hello { position: relative; max-width: 260px; margin: 0; padding: 14px 34px 14px 16px; border-radius: 18px 18px 4px 18px; cursor: pointer;
    background: var(--surface); color: var(--text); font-size: 0.9rem; line-height: 1.45;
    box-shadow: 0 20px 44px -16px color-mix(in srgb, var(--shadow) 55%, transparent), 0 0 0 1px var(--line);
    opacity: 0; transform: translateY(10px) scale(0.95); transform-origin: bottom right; transition: opacity 0.35s, transform 0.5s var(--ease); }
  .vi-hello.show { opacity: 1; transform: none; }
  .vi-hello span { display: block; margin-bottom: 2px; color: var(--heading); }
  .vi-hello-x { position: absolute; right: 8px; top: 6px; border: 0; background: none; font-size: 1.2rem; line-height: 1; color: var(--muted); cursor: pointer; }

  /* ── panel ── */
  .vi-panel { position: absolute; right: 0; bottom: 0; width: min(390px, calc(100vw - 32px)); height: min(600px, calc(100svh - 100px)); display: flex; flex-direction: column;
    border-radius: 26px; overflow: hidden; background: var(--bg); transform-origin: bottom right;
    box-shadow: 0 50px 100px -30px color-mix(in srgb, var(--shadow) 75%, transparent), 0 0 0 1px var(--line);
    animation: panel-in 0.55s cubic-bezier(0.2, 1.3, 0.4, 1); }
  .vi-panel.closing { animation: panel-out 0.28s ease-in forwards; }
  @keyframes panel-in { from { opacity: 0; transform: translateY(24px) scale(0.85); border-radius: 40px; } }
  @keyframes panel-out { to { opacity: 0; transform: translateY(18px) scale(0.9); } }
  .vi-head { display: flex; align-items: center; gap: 12px; padding: 14px 12px 14px 16px; background: var(--deep); color: var(--on-deep); position: relative; isolation: isolate; }
  .vi-head::after { content: ""; position: absolute; inset: 0; z-index: -1; opacity: 0.5;
    background: radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--accent) 35%, transparent), transparent 55%); }
  .vi-id { flex: 1; min-width: 0; }
  .vi-name { margin: 0; font-size: 2.1rem; line-height: 0.9; }
  .vi-status { margin: 0; display: flex; align-items: center; gap: 6px; font-size: 0.76rem; color: var(--deep-text); }
  .vi-status i { width: 7px; height: 7px; border-radius: 50%; background: #3ddc84; box-shadow: 0 0 0 0 rgba(61, 220, 132, 0.6); animation: online 2s infinite; }
  @keyframes online { 70% { box-shadow: 0 0 0 7px rgba(61, 220, 132, 0); } 100% { box-shadow: 0 0 0 0 rgba(61, 220, 132, 0); } }
  .vi-icon { display: grid; place-items: center; width: 34px; height: 34px; border: 0; border-radius: 10px; cursor: pointer;
    background: color-mix(in srgb, var(--on-deep) 10%, transparent); color: var(--on-deep); transition: background 0.25s, transform 0.3s var(--ease); }
  .vi-icon:hover { background: var(--accent-deep); color: var(--on-accent); }
  [data-vi-reset]:hover { transform: rotate(-90deg); }

  .vi-log { flex: 1; overflow-y: auto; padding: 18px 16px; display: flex; flex-direction: column; gap: 12px; overscroll-behavior: contain; scrollbar-width: thin; }
  .vi-log :global(.vi-msg) { display: flex; gap: 8px; max-width: 90%; animation: msg-in 0.45s var(--ease) both; }
  .vi-log :global(.vi-msg.user) { align-self: flex-end; animation-name: msg-in-right; }
  .vi-log :global(.vi-msg p) { margin: 0; padding: 10px 14px; border-radius: 18px; font-size: 0.94rem; line-height: 1.58; overflow-wrap: anywhere; }
  .vi-log :global(.vi-msg.bot p) { background: var(--surface); color: var(--text); border-top-left-radius: 5px; box-shadow: 0 1px 0 var(--line), 0 10px 24px -20px color-mix(in srgb, var(--shadow) 40%, transparent); }
  .vi-log :global(.vi-msg.user p) { background: var(--accent); color: var(--on-accent); border-top-right-radius: 5px; }
  .vi-log :global(.vi-msg a) { color: inherit; font-weight: 600; text-decoration-color: color-mix(in srgb, currentColor 40%, transparent); }
  .vi-log :global(.vi-msg.bot a) { color: var(--accent); }
  @keyframes msg-in { from { opacity: 0; transform: translate(-10px, 10px) scale(0.97); } }
  @keyframes msg-in-right { from { opacity: 0; transform: translate(10px, 10px) scale(0.97); } }

  /* thinking dots, then a blinking caret while typing */
  .vi-log :global(.dots) { display: inline-flex; gap: 5px; padding: 5px 2px; }
  .vi-log :global(.dots i) { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); opacity: 0.35; animation: dot 1.2s infinite ease-in-out; }
  .vi-log :global(.dots i:nth-child(2)) { animation-delay: 0.16s; }
  .vi-log :global(.dots i:nth-child(3)) { animation-delay: 0.32s; }
  @keyframes dot { 0%, 80%, 100% { opacity: 0.3; transform: translateY(0) scale(0.85); } 40% { opacity: 1; transform: translateY(-5px) scale(1); } }
  .vi-log :global(.thinking .orb) { animation-duration: 1.6s; }
  .vi-log :global(.caret) { display: inline-block; width: 2px; height: 1.05em; margin-left: 2px; vertical-align: -0.15em; border-radius: 1px; background: var(--accent); animation: blink 0.9s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .vi-log :global(.vi-sugs) { display: flex; flex-wrap: wrap; gap: 8px; padding-left: 34px; }
  .vi-log :global(.vi-sugs button) { font: inherit; font-size: 0.84rem; padding: 8px 13px; border-radius: 999px; cursor: pointer; background: var(--bg); color: var(--heading);
    border: 1.5px solid var(--line); animation: msg-in 0.5s var(--ease) both; animation-delay: calc(0.25s + var(--i) * 0.08s);
    transition: border-color 0.2s, color 0.2s, transform 0.3s var(--ease); }
  .vi-log :global(.vi-sugs button:hover) { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); }

  .vi-form { display: flex; gap: 8px; padding: 12px; border-top: 1px solid var(--line); background: var(--bg); }
  .vi-form input { flex: 1; min-width: 0; font: inherit; font-size: 0.94rem; padding: 12px 15px; border-radius: 15px; border: 0; outline: none; color: var(--text);
    background: var(--surface-2); transition: box-shadow 0.25s; }
  .vi-form input:focus { box-shadow: 0 0 0 2px var(--accent); }
  .vi-form button { display: grid; place-items: center; width: 46px; border: 0; border-radius: 15px; cursor: pointer; background: var(--accent); color: var(--on-accent);
    transition: transform 0.3s var(--ease), opacity 0.2s; }
  .vi-form button:hover:not(:disabled) { transform: translateY(-2px) rotate(-8deg); }
  .vi-form button:disabled { opacity: 0.5; cursor: wait; }
  .vi-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 0 12px 12px; background: var(--bg); }
  .vi-foot p { margin: 0; font-size: 0.74rem; color: var(--muted); line-height: 1.3; }
  .vi-wa { flex: none; display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border-radius: 999px; text-decoration: none;
