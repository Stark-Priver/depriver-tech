---
// "Ask about Privatus": a small chat assistant answered by Cloudflare Workers AI, grounded in /llms-full.txt.
import { site } from "../data/site";
const suggestions = ["What does Privatus do?", "Can he build an app for my business?", "Tell me his story in short", "How can I contact him?"];
---
{site.engageApi && (
  <div class="ai" data-ai data-api={site.engageApi}>
    <button class="ai-fab" type="button" data-ai-toggle aria-expanded="false" aria-controls="ai-panel">
      <img src="/favicon-32.png" alt="" width="28" height="28" />
      <span>Ask about me</span>
      <i class="ai-dot" aria-hidden="true"></i>
    </button>

    <section class="ai-panel" id="ai-panel" role="dialog" aria-label="Ask about Privatus" hidden>
      <header class="ai-head">
        <img src="/icon-192.png" alt="" width="40" height="40" />
        <div>
          <p class="ai-title">Ask about Privatus</p>
          <p class="ai-sub">AI assistant · answers from this website</p>
        </div>
        <button class="ai-x" type="button" data-ai-close aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </header>
      <div class="ai-log" data-ai-log aria-live="polite">
        <div class="ai-msg bot"><p>Hi! 👋 I can tell you about Privatus: his work, his story and how he can help you. What would you like to know?</p></div>
        <div class="ai-sugs" data-ai-sugs>
          {suggestions.map((s) => <button type="button" data-sug>{s}</button>)}
        </div>
      </div>
      <form class="ai-form" data-ai-form>
        <input name="q" type="text" maxlength="500" autocomplete="off" placeholder="Ask a question… (English or Swahili)" aria-label="Your question" required />
        <button type="submit" aria-label="Send">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7Z"/></svg>
        </button>
      </form>
      <p class="ai-foot">AI can make mistakes. For anything important, <a href="https://wa.me/255752747681" target="_blank" rel="noopener">message Privatus directly</a>.</p>
    </section>
  </div>
)}

<script>
  const root = document.querySelector<HTMLElement>("[data-ai]");
  if (root) {
    const api = root.dataset.api!;
    const panel = root.querySelector<HTMLElement>(".ai-panel")!;
    const toggle = root.querySelector<HTMLButtonElement>("[data-ai-toggle]")!;
    const log = root.querySelector<HTMLElement>("[data-ai-log]")!;
    const form = root.querySelector<HTMLFormElement>("[data-ai-form]")!;
    const input = form.querySelector<HTMLInputElement>("input")!;
    const history: { role: "user" | "assistant"; content: string }[] = [];

    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
    // light formatting: **bold**, links, line breaks
    const fmt = (s: string) => esc(s)
      .replace(/\*\*(.+?)\*\*/g, "<b>$1</b>")
      .replace(/(https?:\/\/[^\s)]+)/g, '<a href="$1" target="_blank" rel="noopener">$1</a>')
      .replace(/\n/g, "<br />");

    const open = (on: boolean) => {
      panel.hidden = !on;
      toggle.setAttribute("aria-expanded", String(on));
      root.classList.toggle("open", on);
      if (on) input.focus();
    };
    toggle.addEventListener("click", () => open(panel.hidden));
    root.querySelector("[data-ai-close]")!.addEventListener("click", () => { open(false); toggle.focus(); });
    panel.addEventListener("keydown", (e) => { if (e.key === "Escape") { open(false); toggle.focus(); } });

    function bubble(role: "user" | "bot", html: string) {
      const d = document.createElement("div");
      d.className = `ai-msg ${role}`;
      d.innerHTML = `<p>${html}</p>`;
      log.append(d);
      log.scrollTop = log.scrollHeight;
      return d;
    }

    async function send(q: string) {
      q = q.trim();
      if (!q) return;
      root.querySelector("[data-ai-sugs]")?.remove();
      bubble("user", esc(q));
      input.value = "";
      const wait = bubble("bot", '<span class="ai-typing"><i></i><i></i><i></i></span>');
      form.querySelector("button")!.disabled = true;
      try {
        const r = await fetch(`${api}/ask`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ question: q, history }) });
        const out = await r.json();
        const answer = r.ok ? out.answer : out.error;
        wait.innerHTML = `<p>${fmt(answer)}</p>`;
        if (r.ok) history.push({ role: "user", content: q }, { role: "assistant", content: answer });
      } catch {
        wait.innerHTML = "<p>I couldn't connect just now. Please try again, or message Privatus on WhatsApp: +255 752 747 681.</p>";
      } finally {
        form.querySelector("button")!.disabled = false;
        log.scrollTop = log.scrollHeight;
        input.focus();
      }
    }
    form.addEventListener("submit", (e) => { e.preventDefault(); send(input.value); });
    log.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-sug]");
      if (b) send(b.textContent || "");
    });
  }
</script>

<style>
  .ai { position: fixed; right: 20px; bottom: 20px; z-index: 55; }
  .ai-fab { display: flex; align-items: center; gap: 10px; padding: 7px 18px 7px 7px; border: 0; border-radius: 999px; cursor: pointer; font: inherit; font-weight: 600;
    background: var(--deep); color: var(--on-deep); box-shadow: 0 18px 40px -14px color-mix(in srgb, var(--shadow) 70%, transparent), 0 0 0 1px color-mix(in srgb, var(--on-deep) 10%, transparent);
    transition: transform 0.4s var(--ease); position: relative; }
  .ai-fab:hover { transform: translateY(-3px); }
  .ai-fab img { border-radius: 50%; }
  .ai-dot { position: absolute; left: 30px; top: 7px; width: 10px; height: 10px; border-radius: 50%; background: #3ddc84; box-shadow: 0 0 0 2px var(--deep); }
  .ai.open .ai-fab { display: none; }
  .ai-panel { position: absolute; right: 0; bottom: 0; width: min(380px, calc(100vw - 32px)); height: min(560px, calc(100svh - 110px)); display: flex; flex-direction: column;
    border-radius: 24px; overflow: hidden; background: var(--bg);
    box-shadow: 0 40px 90px -30px color-mix(in srgb, var(--shadow) 70%, transparent), 0 0 0 1px var(--line); animation: ai-in 0.45s var(--ease); }
  @keyframes ai-in { from { opacity: 0; transform: translateY(16px) scale(0.97); } }
  .ai-head { display: flex; align-items: center; gap: 12px; padding: 14px 14px 14px 16px; background: var(--deep); color: var(--on-deep); }
  .ai-head img { border-radius: 50%; }
  .ai-title { margin: 0; font-weight: 700; }
  .ai-sub { margin: 0; font-size: 0.78rem; color: var(--deep-text); }
  .ai-x { margin-left: auto; display: grid; place-items: center; width: 34px; height: 34px; border: 0; border-radius: 10px; cursor: pointer;
    background: color-mix(in srgb, var(--on-deep) 10%, transparent); color: var(--on-deep); }
  .ai-log { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; overscroll-behavior: contain; }
  .ai-msg { max-width: 86%; }
  .ai-msg p { margin: 0; padding: 10px 14px; border-radius: 16px; font-size: 0.94rem; line-height: 1.55; overflow-wrap: anywhere; }
  .ai-msg.bot p { background: var(--surface); color: var(--text); border-top-left-radius: 4px; box-shadow: 0 1px 0 var(--line); }
  .ai-msg.user { align-self: flex-end; }
  .ai-msg.user p { background: var(--accent); color: var(--on-accent); border-top-right-radius: 4px; }
  .ai-msg :global(a) { color: inherit; font-weight: 600; }
  .ai-sugs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .ai-sugs button { font: inherit; font-size: 0.84rem; padding: 7px 12px; border-radius: 999px; cursor: pointer; background: transparent; color: var(--heading);
    border: 1.5px solid var(--line); transition: border-color 0.2s, color 0.2s; }
  .ai-sugs button:hover { border-color: var(--accent); color: var(--accent); }
  .ai-msg :global(.ai-typing) { display: inline-flex; gap: 4px; padding: 4px 2px; }
  .ai-msg :global(.ai-typing i) { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); animation: ai-dot 1.1s infinite ease-in-out; }
  .ai-msg :global(.ai-typing i:nth-child(2)) { animation-delay: 0.15s; }
  .ai-msg :global(.ai-typing i:nth-child(3)) { animation-delay: 0.3s; }
  @keyframes ai-dot { 0%, 80%, 100% { opacity: 0.3; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-4px); } }
  .ai-form { display: flex; gap: 8px; padding: 12px; border-top: 1px solid var(--line); }
  .ai-form input { flex: 1; min-width: 0; font: inherit; font-size: 0.94rem; padding: 11px 14px; border-radius: 14px; border: 0; outline: none; color: var(--text);
    background: var(--surface-2); }
  .ai-form input:focus { box-shadow: 0 0 0 2px var(--accent); }
  .ai-form button { display: grid; place-items: center; width: 44px; border: 0; border-radius: 14px; cursor: pointer; background: var(--accent); color: var(--on-accent); }
  .ai-form button:disabled { opacity: 0.6; }
  .ai-foot { margin: 0; padding: 0 14px 12px; font-size: 0.72rem; color: var(--muted); }
  .ai-foot a { color: var(--accent); }
  @media (max-width: 560px) {
    .ai { right: 12px; bottom: 12px; }
    .ai-fab span { display: none; }
    .ai-fab { padding: 7px; }
  }
  @media print { .ai { display: none; } }
</style>
