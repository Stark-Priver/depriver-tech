---
// Comments on Cloudflare (Worker + D1): no login, just a name. Protected by Turnstile, a honeypot and rate limits.
import { site } from "../data/site";
interface Props { slug: string }
const { slug } = Astro.props;
---
{site.engageApi && (
  <section class="cm" id="comments" data-comments data-slug={slug} data-api={site.engageApi} data-sitekey={site.turnstileSiteKey} aria-labelledby="cm-title">
    <div class="cm-head">
      <div>
        <p class="cm-label">Conversation</p>
        <h2 id="cm-title">Comments <span data-cm-count></span></h2>
      </div>
      <p class="cm-note">No sign-up needed. Be kind and helpful.</p>
    </div>

    <form class="cm-form" data-cm-form novalidate>
      <p class="cm-replying" data-cm-replying hidden>
        Replying to <b></b> <button type="button" data-cm-cancel>Cancel</button>
      </p>
      <div class="cm-row">
        <label class="cm-field">
          <span>Your name</span>
          <input name="name" type="text" maxlength="60" autocomplete="name" required placeholder="e.g. Asha from Mbeya" />
        </label>
      </div>
      <label class="cm-field">
        <span>Comment</span>
        <textarea name="body" rows="4" maxlength="2000" required placeholder="Share your thoughts, a question or your own experience…"></textarea>
      </label>
      <label class="cm-hp" aria-hidden="true">Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
      <div class="cm-ts" data-cm-ts></div>
      <div class="cm-actions">
        <span class="cm-status" data-cm-status role="status" aria-live="polite"></span>
        <button class="cm-send" type="submit">
          Post comment
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7Z"/></svg>
        </button>
      </div>
    </form>

    <ol class="cm-list" data-cm-list aria-live="polite"></ol>
    <p class="cm-empty" data-cm-empty hidden>No comments yet. Be the first to share your thoughts.</p>
  </section>
)}

<script>
  import { turnstile } from "../lib/turnstile";

  type C = { id: number; parent: number | null; name: string; body: string; owner: number; at: string };

  const root = document.querySelector<HTMLElement>("[data-comments]");
  if (root) {
    const { slug, api, sitekey } = root.dataset as Record<string, string>;
    const list = root.querySelector<HTMLOListElement>("[data-cm-list]")!;
    const empty = root.querySelector<HTMLElement>("[data-cm-empty]")!;
    const count = root.querySelector<HTMLElement>("[data-cm-count]")!;
    const form = root.querySelector<HTMLFormElement>("[data-cm-form]")!;
    const status = root.querySelector<HTMLElement>("[data-cm-status]")!;
    const replying = root.querySelector<HTMLElement>("[data-cm-replying]")!;
    const send = form.querySelector<HTMLButtonElement>(".cm-send")!;
    let parent: number | null = null;
    let comments: C[] = [];
    let ts: { getToken: () => string; reset: () => void } | null = null;

    try { (form.elements.namedItem("name") as HTMLInputElement).value = localStorage.getItem("cm-name") || ""; } catch {}

    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
    const ago = (at: string) => {
      const t = new Date(at.replace(" ", "T") + "Z").getTime();
      const s = Math.max(1, Math.round((Date.now() - t) / 1000));
      const units: [number, string][] = [[31536000, "year"], [2592000, "month"], [604800, "week"], [86400, "day"], [3600, "hour"], [60, "minute"]];
      for (const [n, u] of units) if (s >= n) { const v = Math.floor(s / n); return `${v} ${u}${v > 1 ? "s" : ""} ago`; }
      return "just now";
    };
    const hue = (name: string) => [...name].reduce((h, c) => (h * 31 + c.charCodeAt(0)) % 360, 7);
    const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).slice(0, 2).join("").toUpperCase();

    function item(c: C, isReply = false) {
      const li = document.createElement("li");
      li.className = `cm-item${c.owner ? " owner" : ""}${isReply ? " reply" : ""}`;
      li.id = `comment-${c.id}`;
      li.innerHTML = `
        <span class="cm-av" style="--h:${hue(c.name)}">${c.owner ? '<img src="/favicon-32.png" alt="" />' : esc(initials(c.name))}</span>
        <div class="cm-bubble">
          <p class="cm-meta"><b>${esc(c.name)}</b>${c.owner ? '<span class="cm-badge">Author</span>' : ""}<time datetime="${esc(c.at)}Z">${ago(c.at)}</time></p>
          <p class="cm-body">${esc(c.body).replace(/\n/g, "<br />")}</p>
          ${isReply ? "" : `<button type="button" class="cm-reply" data-reply="${c.id}" data-name="${esc(c.name)}">Reply</button>`}
        </div>`;
      return li;
    }

    function render() {
      list.innerHTML = "";
      const top = comments.filter((c) => !c.parent);
      top.forEach((c) => {
        const li = item(c);
        const kids = comments.filter((k) => k.parent === c.id);
        if (kids.length) {
          const ol = document.createElement("ol");
          ol.className = "cm-replies";
          kids.forEach((k) => ol.append(item(k, true)));
          li.querySelector(".cm-bubble")!.append(ol);
        }
        list.append(li);
      });
      empty.hidden = comments.length > 0;
      count.textContent = comments.length ? `(${comments.length})` : "";
    }

    async function loadComments() {
      try {
        const r = await fetch(`${api}/comments/${slug}`);
        comments = r.ok ? (await r.json()).comments : [];
      } catch { comments = []; }
      render();
    }

    list.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-reply]");
      if (!b) return;
      parent = Number(b.dataset.reply);
      replying.hidden = false;
      replying.querySelector("b")!.textContent = b.dataset.name!;
      form.scrollIntoView({ behavior: "smooth", block: "center" });
      (form.elements.namedItem("body") as HTMLTextAreaElement).focus({ preventScroll: true });
    });
    root.querySelector("[data-cm-cancel]")!.addEventListener("click", () => { parent = null; replying.hidden = true; });

    // load Turnstile only when someone starts writing
    form.addEventListener("focusin", async () => {
      if (!ts) ts = await turnstile(root.querySelector<HTMLElement>("[data-cm-ts]")!, sitekey).catch(() => ({ getToken: () => "", reset: () => {} }));
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get("name") || "").trim();
      const body = String(data.get("body") || "").trim();
      if (name.length < 2 || body.length < 2) { status.textContent = "Please add your name and a comment."; status.className = "cm-status err"; return; }
      send.disabled = true;
      status.textContent = "Posting…"; status.className = "cm-status";
      try {
        const r = await fetch(`${api}/comments/${slug}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name, body, parent, website: data.get("website"), token: ts?.getToken() || "" }),
        });
        const out = await r.json();
        if (!r.ok) throw new Error(out.error || "Could not post your comment.");
        try { localStorage.setItem("cm-name", name); } catch {}
        (form.elements.namedItem("body") as HTMLTextAreaElement).value = "";
        parent = null; replying.hidden = true;
        if (out.status === "published") {
          comments.push(out.comment);
          render();
          document.getElementById(`comment-${out.comment.id}`)?.classList.add("new");
          status.textContent = "Thanks! Your comment is live.";
        } else {
          status.textContent = "Thanks! Your comment will appear once it's approved.";
        }
        status.className = "cm-status ok";
      } catch (err) {
        status.textContent = (err as Error).message; status.className = "cm-status err";
      } finally {
        send.disabled = false;
        ts?.reset();
      }
    });

    new IntersectionObserver((entries, io) => { if (entries[0].isIntersecting) { io.disconnect(); loadComments(); } }, { rootMargin: "600px" }).observe(root);
  }
</script>

<style>
  .cm { max-width: 820px; margin: 0 auto; padding: 20px 0 80px; }
  .cm-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 8px 20px; margin-bottom: 22px; }
  .cm-label { margin: 0; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .cm h2 { margin: 6px 0 0; font-size: 2rem; color: var(--heading); }
  .cm h2 span { color: var(--muted); font-weight: 500; font-size: 1.4rem; }
  .cm-note { margin: 0; color: var(--muted); }

  .cm-form { display: grid; gap: 14px; padding: 22px; border-radius: 26px; background: var(--bg);
    box-shadow: -8px -8px 20px var(--neu-hi), 10px 10px 24px var(--neu-lo); margin-bottom: 34px; }
  .cm-field { display: grid; gap: 6px; }
  .cm-field span { font-size: 0.82rem; font-weight: 600; color: var(--heading); }
  .cm-field input, .cm-field textarea { font: inherit; color: var(--text); border: 0; border-radius: 14px; padding: 12px 16px; resize: vertical; outline: none;
    background: var(--bg); box-shadow: inset 4px 4px 9px var(--neu-lo), inset -4px -4px 9px var(--neu-hi); transition: box-shadow 0.25s; }
  .cm-field input:focus, .cm-field textarea:focus { box-shadow: inset 4px 4px 9px var(--neu-lo), inset -4px -4px 9px var(--neu-hi), 0 0 0 2px var(--accent); }
  .cm-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .cm-replying { margin: 0; font-size: 0.9rem; color: var(--muted); }
  .cm-replying button { font: inherit; font-weight: 600; color: var(--accent); background: none; border: 0; cursor: pointer; padding: 0 0 0 6px; }
  .cm-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
  .cm-status { font-size: 0.92rem; color: var(--muted); }
  .cm-status.ok { color: var(--heading); font-weight: 500; }
  .cm-status.err { color: var(--accent); font-weight: 500; }
  .cm-send { display: inline-flex; align-items: center; gap: 10px; margin-left: auto; font: inherit; font-weight: 600; padding: 12px 22px; border: 0; border-radius: 14px; cursor: pointer;
    background: var(--accent); color: var(--on-accent); box-shadow: 0 12px 26px -12px color-mix(in srgb, var(--accent) 70%, transparent); transition: transform 0.3s var(--ease); }
  .cm-send:hover { transform: translateY(-2px); }
  .cm-send:disabled { opacity: 0.6; cursor: wait; }

  .cm-list, .cm-list :global(.cm-replies) { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  .cm-list :global(.cm-replies) { margin-top: 16px; gap: 14px; }
  .cm-list :global(.cm-item) { display: grid; grid-template-columns: 46px 1fr; gap: 14px; align-items: start; }
  .cm-list :global(.cm-item.new) { animation: cm-in 0.7s var(--ease); }
  @keyframes cm-in { from { opacity: 0; transform: translateY(12px); } }
  .cm-list :global(.cm-av) { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 15px; font-weight: 700; font-size: 0.95rem; overflow: hidden;
    color: #fff; background: hsl(var(--h) 55% 42%); }
  .cm-list :global(.cm-item.reply .cm-av) { width: 38px; height: 38px; border-radius: 12px; font-size: 0.8rem; }
  .cm-list :global(.cm-item.reply) { grid-template-columns: 38px 1fr; }
  .cm-list :global(.cm-av img) { width: 100%; height: 100%; }
  .cm-list :global(.cm-bubble) { min-width: 0; padding: 14px 18px 12px; border-radius: 4px 20px 20px 20px; background: var(--surface);
    box-shadow: 0 1px 0 var(--line), 0 20px 40px -34px color-mix(in srgb, var(--shadow) 40%, transparent); }
  .cm-list :global(.owner > .cm-bubble) { box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--accent) 55%, transparent); }
  .cm-list :global(.cm-meta) { margin: 0 0 4px; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; font-size: 0.88rem; color: var(--muted); }
  .cm-list :global(.cm-meta b) { color: var(--heading); font-size: 0.98rem; }
  .cm-list :global(.cm-badge) { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 2px 8px; border-radius: 999px; background: var(--accent); color: var(--on-accent); }
  .cm-list :global(.cm-body) { margin: 0; color: var(--text); overflow-wrap: anywhere; }
  .cm-list :global(.cm-reply) { margin-top: 6px; padding: 0; font: inherit; font-size: 0.85rem; font-weight: 600; color: var(--accent); background: none; border: 0; cursor: pointer; }
  .cm-empty { color: var(--muted); text-align: center; padding: 20px; }
</style>
