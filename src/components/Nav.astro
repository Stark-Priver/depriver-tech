---
import ThemePicker from "./ThemePicker.astro";
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Blog", short: "Blog" },
  { href: "/story/", label: "My story", short: "Story" },
  { href: "/story/#next", label: "Next", short: "Next" },
  { href: "/story/#contact", label: "Contact", short: "Contact" },
];
---
<header class="nav" data-nav>
  <div class="wrap nav-in">
    <a href="/" class="brand" aria-label="Privatus Cosmas, home">
      <span class="script">Privatus</span><span class="dot"></span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={l.href === path ? "page" : undefined}><span class="long">{l.label}</span><span class="short">{l.short}</span></a></li>
        ))}
      </ul>
    </nav>
    <div class="right">
      <ThemePicker />
      <a class="cta" href="https://wa.me/255752747681" target="_blank" rel="noopener">Let's talk</a>
    </div>
  </div>
</header>

<style>
  .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; transition: background 0.4s, box-shadow 0.4s, transform 0.5s var(--ease); }
  .nav.scrolled { background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(14px) saturate(1.3); box-shadow: 0 1px 0 var(--line); }
  .nav.hidden { transform: translateY(-100%); }
  .nav-in { display: flex; align-items: center; justify-content: space-between; height: 76px; gap: 16px; min-width: 0; }
  nav { min-width: 0; }
  .short { display: none; }
  .brand { display: flex; align-items: flex-end; flex: none; min-height: 44px; padding: 6px 0; text-decoration: none; color: var(--heading); }
  .brand .script { font-size: 2.1rem; line-height: 1; }
  .brand .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); margin: 0 0 6px 4px; }
  ul { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; }
  ul a { display: block; padding: 8px 14px; border-radius: 12px; text-decoration: none; font-weight: 500; font-size: 0.95rem; color: var(--heading); transition: background 0.3s, color 0.3s; }
  ul a:hover, ul a[aria-current] { background: var(--deep); color: var(--on-deep); }
  .right { display: flex; align-items: center; gap: 10px; }
  .cta { padding: 10px 18px; border-radius: 12px; background: var(--accent); color: var(--on-accent); text-decoration: none; font-weight: 600; font-size: 0.95rem; }
  @media (max-width: 760px) {
    .cta { display: none; }
    ul a { padding: 8px 10px; font-size: 0.88rem; }
    ul { gap: 0; }
    .brand .script { font-size: 1.8rem; }
  }
  @media (max-width: 760px) { ul li:nth-child(3) { display: none; } }
  @media (max-width: 560px) {
    .nav-in { gap: 8px; height: 68px; }
    .long { display: none; }
    .short { display: inline; }
    ul li:nth-child(4) { display: none; }
    ul a { padding: 10px; min-height: 40px; display: flex; align-items: center; }
    .brand .script { font-size: 1.65rem; }
  }
  @media (max-width: 340px) { .brand .dot { display: none; } ul a { padding: 10px 8px; } }
</style>
