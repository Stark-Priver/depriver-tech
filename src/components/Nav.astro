---
import ThemePicker from "./ThemePicker.astro";
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Blog", match: (p: string) => p === "/" || p.startsWith("/blog") },
  { href: "/guides/", label: "Guides", match: (p: string) => p.startsWith("/guides") },
  { href: "/talks/", label: "Talks", match: (p: string) => p.startsWith("/talks") },
  { href: "/story/", label: "My story", match: (p: string) => p.startsWith("/story") },
  { href: "/story/#contact", label: "Contact", match: () => false },
];
---
<header class="nav" data-nav>
  <div class="wrap nav-in">
    <a href="/" class="brand" aria-label="Privatus Cosmas, home">
      <span class="script">Privatus</span><span class="dot"></span>
    </a>
    <nav aria-label="Main" class="links">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={l.match(path) ? "page" : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="right">
      <ThemePicker />
      <a class="cta" href="https://wa.me/255752747681" target="_blank" rel="noopener" title="Let's talk on WhatsApp">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.5-.3Z"/></svg>
        <span>Let's talk</span>
      </a>
      <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu" data-burger>
        <span></span><span></span>
      </button>
    </div>
  </div>
  <div class="menu deep" id="menu" data-menu hidden>
    <ul>
      {links.map((l, i) => (
        <li style={`--i:${i}`}><a href={l.href} aria-current={l.match(path) ? "page" : undefined}><small>0{i + 1}</small>{l.label}</a></li>
      ))}
    </ul>
    <a class="menu-cta" href="https://wa.me/255752747681" target="_blank" rel="noopener" style={`--i:${links.length}`}>Let's talk on WhatsApp →</a>
  </div>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>("[data-burger]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  if (burger && menu) {
    const set = (open: boolean) => {
      burger.setAttribute("aria-expanded", String(open));
      document.documentElement.classList.toggle("menu-open", open);
      if (open) { menu.hidden = false; requestAnimationFrame(() => menu.classList.add("open")); }
      else { menu.classList.remove("open"); setTimeout(() => { if (!menu.classList.contains("open")) menu.hidden = true; }, 450); }
    };
    burger.addEventListener("click", () => set(burger.getAttribute("aria-expanded") !== "true"));
    menu.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest("a")) set(false); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") set(false); });
    matchMedia("(min-width: 761px)").addEventListener("change", (m) => m.matches && set(false));
  }
</script>

<style>
  .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; transition: background 0.4s, box-shadow 0.4s, transform 0.5s var(--ease); }
  .nav.scrolled { background: color-mix(in srgb, var(--bg) 80%, transparent); backdrop-filter: blur(16px) saturate(1.4); -webkit-backdrop-filter: blur(16px) saturate(1.4);
    box-shadow: 0 1px 0 var(--line), 0 12px 30px -24px color-mix(in srgb, var(--shadow) 60%, transparent); }
  .nav.hidden { transform: translateY(-100%); }
  :global(.menu-open) .nav { transform: none; background: transparent; box-shadow: none; backdrop-filter: none; }
  .nav-in { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 80px; gap: 20px; min-width: 0;
    transition: height 0.4s var(--ease); }
  .nav.scrolled .nav-in { height: 66px; }

  .brand { justify-self: start; display: flex; align-items: flex-end; min-height: 44px; padding: 6px 0; text-decoration: none; color: var(--heading); transition: color 0.3s; }
  :global(.menu-open) .brand { color: var(--on-deep); }
  .brand .script { font-size: 2.1rem; line-height: 1; }
  .brand .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); margin: 0 0 6px 4px; transition: transform 0.4s var(--ease); }
  .brand:hover .dot { transform: scale(1.5); }

  .links ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 5px; border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 75%, transparent); box-shadow: inset 0 0 0 1px var(--line), 0 10px 24px -20px color-mix(in srgb, var(--shadow) 70%, transparent); }
  .links a { position: relative; display: block; padding: 9px 18px; border-radius: 999px; white-space: nowrap; text-decoration: none; font-weight: 500; font-size: 0.94rem;
    color: var(--muted); transition: background 0.3s, color 0.3s; }
  .links a:hover { color: var(--heading); background: color-mix(in srgb, var(--heading) 7%, transparent); }
  .links a[aria-current] { background: var(--heading); color: var(--bg); font-weight: 600; }
  .links a:focus-visible, .cta:focus-visible, .burger:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .right { justify-self: end; display: flex; align-items: center; gap: 10px; }
  .cta { display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 18px; border-radius: 999px; white-space: nowrap; background: var(--accent); color: var(--on-accent);
    text-decoration: none; font-weight: 600; font-size: 0.94rem; box-shadow: 0 10px 22px -14px color-mix(in srgb, var(--accent) 80%, transparent); transition: transform 0.3s var(--ease), box-shadow 0.3s; }
  .cta:hover { transform: translateY(-2px); box-shadow: 0 16px 28px -14px color-mix(in srgb, var(--accent) 85%, transparent); }
  .right :global(.tp-btn) { border-radius: 999px; }
  .burger { display: none; position: relative; width: 44px; height: 44px; border: 0; border-radius: 999px; cursor: pointer; background: var(--deep); }
  .burger span { position: absolute; left: 13px; right: 13px; height: 2px; border-radius: 2px; background: var(--on-deep); transition: transform 0.4s var(--ease), top 0.4s var(--ease); }
  .burger span:first-child { top: 18px; } .burger span:last-child { top: 25px; }
  .burger[aria-expanded="true"] { background: var(--accent); }
  .burger[aria-expanded="true"] span:first-child { top: 21px; transform: rotate(45deg); }
  .burger[aria-expanded="true"] span:last-child { top: 21px; transform: rotate(-45deg); }

  .menu { position: fixed; inset: 0; z-index: 1; display: flex; flex-direction: column; justify-content: center; gap: 30px; padding: 100px var(--gutter) 40px;
    clip-path: circle(0 at calc(100% - 44px) 38px); transition: clip-path 0.55s var(--ease); }
  .menu.open { clip-path: circle(150% at calc(100% - 44px) 38px); }
  .menu ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .menu li, .menu-cta { opacity: 0; transform: translateY(24px); transition: opacity 0.5s, transform 0.6s var(--ease); transition-delay: calc(0.12s + var(--i) * 0.06s); }
  .menu.open li, .menu.open .menu-cta { opacity: 1; transform: none; }
  .menu ul a { display: flex; align-items: baseline; gap: 14px; text-decoration: none; color: var(--on-deep); font-weight: 700; font-size: clamp(2.2rem, 11vw, 3.4rem); line-height: 1.15; letter-spacing: -0.03em; }
  .menu ul a small { font-size: 0.85rem; font-weight: 600; color: var(--accent); letter-spacing: 0; }
  .menu ul a[aria-current] { color: var(--accent); }
  .menu-cta { align-self: flex-start; padding: 14px 22px; border-radius: 14px; background: var(--accent); color: var(--on-accent); font-weight: 600; text-decoration: none; }
  @media (prefers-reduced-motion: reduce) { .menu, .menu li, .menu-cta { transition: none; } }

  @media (max-width: 1100px) {
    .links a { padding: 9px 14px; }
  }
  @media (max-width: 980px) {
    .nav-in { gap: 12px; }
    .links a { padding: 8px 11px; font-size: 0.88rem; }
    .cta { width: 42px; padding: 0; justify-content: center; }
    .cta span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
  @media (max-width: 760px) {
    .nav-in { grid-template-columns: 1fr auto; }
    .links, .cta { display: none; }
    .burger { display: block; }
    .nav-in, .nav.scrolled .nav-in { height: 66px; }
    .brand .script { font-size: 1.8rem; }
  }
</style>
