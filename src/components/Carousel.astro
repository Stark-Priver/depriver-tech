---
// Swipeable slide viewer for carousel posts: scroll-snap track, arrows, dots, keys (← →), fullscreen.
interface Props { slides: string[]; captions?: string[]; title: string }
const { slides, captions = [], title } = Astro.props;
---
<section class="cv" data-cv aria-roledescription="carousel" aria-label={`${title}: ${slides.length} slides`}>
  <div class="cv-stage">
    <div class="cv-track" data-track tabindex="0" aria-live="polite">
      {slides.map((src, i) => (
        <figure class="cv-slide" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}>
          <img src={src} alt={captions[i] ?? `${title}, slide ${i + 1}`} width="1080" height="1350"
            loading={i < 2 ? "eager" : "lazy"} decoding="async" draggable="false" />
        </figure>
      ))}
    </div>
    <button class="cv-nav prev" type="button" data-prev aria-label="Previous slide">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <button class="cv-nav next" type="button" data-next aria-label="Next slide">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
    </button>
    <span class="cv-count" data-cv-count>1 / {slides.length}</span>
    <button class="cv-full" type="button" data-full aria-label="View full screen">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
    </button>
  </div>
  <div class="cv-bar">
    <div class="cv-dots" role="tablist" aria-label="Choose slide">
      {slides.map((_, i) => <button type="button" role="tab" aria-label={`Slide ${i + 1}`} data-dot={i}></button>)}
    </div>
    <div class="cv-progress" aria-hidden="true"><span data-progress></span></div>
  </div>
  {captions.length > 0 && <p class="cv-caption" data-caption>{captions[0]}</p>}
  <script type="application/json" data-captions set:html={JSON.stringify(captions)} />
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-cv]").forEach((cv) => {
    const track = cv.querySelector<HTMLElement>("[data-track]")!;
    const slides = [...track.children] as HTMLElement[];
    const dots = [...cv.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    const count = cv.querySelector<HTMLElement>("[data-cv-count]")!;
    const progress = cv.querySelector<HTMLElement>("[data-progress]")!;
    const caption = cv.querySelector<HTMLElement>("[data-caption]");
    const captions: string[] = JSON.parse(cv.querySelector("[data-captions]")!.textContent || "[]");
    const prev = cv.querySelector<HTMLButtonElement>("[data-prev]")!;
    const next = cv.querySelector<HTMLButtonElement>("[data-next]")!;
    let index = 0;

    const go = (i: number) => {
      i = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: slides[i].offsetLeft - track.offsetLeft, behavior: "smooth" });
    };
    const update = (i: number) => {
      if (i === index && count.textContent !== "") { /* still refresh below */ }
      index = i;
      count.textContent = `${i + 1} / ${slides.length}`;
      dots.forEach((d, n) => d.setAttribute("aria-selected", String(n === i)));
      progress.style.transform = `scaleX(${(i + 1) / slides.length})`;
      prev.disabled = i === 0;
      next.disabled = i === slides.length - 1;
      if (caption && captions[i]) caption.textContent = captions[i];
      cv.dispatchEvent(new CustomEvent("cv:slide", { detail: i }));
    };

    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && e.intersectionRatio > 0.6 && update(slides.indexOf(e.target as HTMLElement))),
      { root: track, threshold: [0.6] },
    );
    slides.forEach((s) => io.observe(s));

    prev.addEventListener("click", () => go(index - 1));
    next.addEventListener("click", () => go(index + 1));
    dots.forEach((d, n) => d.addEventListener("click", () => go(n)));
    cv.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); go(index + 1); }
      if (e.key === "ArrowLeft") { e.preventDefault(); go(index - 1); }
    });

    // drag to swipe with a mouse (touch already swipes natively)
    let startX = 0, startLeft = 0, dragging = false;
    track.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse") return;
      dragging = true; startX = e.clientX; startLeft = track.scrollLeft;
      track.classList.add("dragging");
    });
    window.addEventListener("pointermove", (e) => { if (dragging) track.scrollLeft = startLeft - (e.clientX - startX); });
    window.addEventListener("pointerup", (e) => {
      if (!dragging) return;
      dragging = false; track.classList.remove("dragging");
      const dx = e.clientX - startX;
      go(Math.abs(dx) > 60 ? index + (dx < 0 ? 1 : -1) : index);
    });

    cv.querySelector("[data-full]")!.addEventListener("click", () => {
      const stage = cv.querySelector<HTMLElement>(".cv-stage")!;
      document.fullscreenElement ? document.exitFullscreen() : stage.requestFullscreen?.();
    });
    document.addEventListener("fullscreenchange", () => requestAnimationFrame(() => go(index)));
    update(0);
  });
</script>

<style>
  .cv { margin: 0 auto 56px; max-width: 620px; }
  .cv-stage { position: relative; border-radius: 26px; overflow: hidden; background: var(--deep);
    box-shadow: -10px -10px 24px var(--neu-hi), 14px 16px 34px var(--neu-lo); }
  .cv-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; outline: none; cursor: grab; }
  .cv-track::-webkit-scrollbar { display: none; }
  .cv-track.dragging { scroll-snap-type: none; scroll-behavior: auto; cursor: grabbing; }
  .cv-track:focus-visible { box-shadow: inset 0 0 0 3px var(--accent); }
  .cv-slide { flex: 0 0 100%; margin: 0; scroll-snap-align: center; aspect-ratio: 4 / 5; }
  .cv-slide img { width: 100%; height: 100%; object-fit: cover; user-select: none; -webkit-user-drag: none; }
  .cv-nav { position: absolute; top: 50%; translate: 0 -50%; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; border: 0; cursor: pointer;
    background: color-mix(in srgb, var(--bg) 88%, transparent); color: var(--heading); backdrop-filter: blur(8px);
    box-shadow: 0 10px 30px -10px color-mix(in srgb, var(--shadow) 60%, transparent); transition: opacity 0.3s, transform 0.3s var(--ease); }
  .cv-nav:hover { background: var(--accent); color: var(--on-accent); transform: scale(1.06); }
  .cv-nav:disabled { opacity: 0; pointer-events: none; }
  .prev { left: 14px; } .next { right: 14px; }
  .cv-count, .cv-full { position: absolute; top: 14px; border-radius: 999px; font-weight: 600; font-size: 0.85rem;
    background: color-mix(in srgb, var(--deep) 75%, transparent); color: var(--on-deep); backdrop-filter: blur(8px); }
  .cv-count { left: 14px; padding: 6px 12px; }
  .cv-full { right: 14px; border: 0; width: 38px; height: 38px; display: grid; place-items: center; cursor: pointer; }
  .cv-full:hover { background: var(--accent); color: var(--on-accent); }
  .cv-stage:fullscreen { border-radius: 0; display: grid; place-items: center; background: #000; }
  .cv-stage:fullscreen .cv-track { width: min(100vw, calc(100vh * 0.8)); }
  .cv-bar { display: flex; flex-direction: column; align-items: center; gap: 12px; margin-top: 20px; }
  .cv-dots { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .cv-dots { gap: 0; }
  /* each dot has a 30px tap area; the visible pill is drawn with ::before */
  .cv-dots button { position: relative; width: 26px; height: 32px; padding: 0; border: 0; cursor: pointer; background: none; transition: width 0.4s var(--ease); }
  .cv-dots button::before { content: ""; position: absolute; left: 50%; top: 50%; width: 9px; height: 9px; translate: -50% -50%; border-radius: 999px; background: var(--line); transition: width 0.4s var(--ease), background 0.3s; }
  .cv-dots button[aria-selected="true"] { width: 40px; }
  .cv-dots button[aria-selected="true"]::before { width: 28px; background: var(--accent); }
  .cv-progress { width: min(240px, 60%); height: 3px; border-radius: 3px; background: var(--line); overflow: hidden; }
  .cv-progress span { display: block; height: 100%; background: var(--heading); transform-origin: left; transition: transform 0.5s var(--ease); }
  .cv-caption { margin: 16px auto 0; max-width: 34em; text-align: center; color: var(--muted); font-size: 1rem; min-height: 3.2em; }
  @media (hover: none) { .cv-nav { width: 44px; height: 44px; } }
  /* small phones: swipe, arrows, the "3 / 11" counter and the progress bar handle navigation */
  @media (max-width: 420px) { .cv-dots { display: none; } .cv-bar { margin-top: 14px; } }
</style>
